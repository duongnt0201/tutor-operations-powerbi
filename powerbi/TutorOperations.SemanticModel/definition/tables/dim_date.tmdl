	partition dim_date = m
		mode: import
		queryGroup: Dim
		source = ```
				let
				    // Create parameter
				    EndOfCurrentYear = DateTime.Date(Date.EndOfYear(Date.AddYears(DateTime.LocalNow(), 0))),
				    StartDate = #date(2024, 1, 1),
				    Step = Duration.Days(EndOfCurrentYear - StartDate) + 1,
				
				    // Create the List of date
				    Source = List.Dates(StartDate, Step, #duration(1, 0, 0, 0)),
				    #"Converted to Table" = Table.FromList(Source, Splitter.SplitByNothing(), null, null, ExtraValues.Error),
				
				    // Create additional columns
				    #"Inserted Year" = Table.AddColumn(#"Converted to Table", "year", each Date.Year([Column1]), Int64.Type),
				    #"Inserted Quarter" = Table.AddColumn(#"Inserted Year", "quarter", each "Q" & Text.From(Date.QuarterOfYear([Column1]))),
				    #"Inserted Month" = Table.AddColumn(#"Inserted Quarter", "month", each Date.Month([Column1]), Int64.Type),
				    #"Inserted Month Name" = Table.AddColumn(#"Inserted Month", "month_name", each Text.Start(Date.MonthName([Column1]), 3), type text),
				    #"Inserted End of Month" = Table.AddColumn(#"Inserted Month Name", "start_of_month", each Date.StartOfMonth([Column1]), type date),
				    #"Renamed Columns" = Table.RenameColumns(#"Inserted End of Month", {{"Column1", "report_date"}}),
				
				    // Define "today"
				    Today = DateTime.Date(DateTime.LocalNow()),
				    CurrentMonth = Date.Month(Today),
				    CurrentYear = Date.Year(Today),
				
				    // Add month_year column
				    #"Added month_year" = Table.AddColumn(#"Renamed Columns", "month_year", each 
				        if Date.Month([report_date]) = CurrentMonth and Date.Year([report_date]) = CurrentYear then "Tháng hiện tại" 
				        else Text.From(Date.Year([report_date])) & "-" & Text.PadStart(Text.From(Date.Month([report_date])), 2, "0")),
				
				    #"Grouped Rows by month_year" = Table.Group(#"Added month_year", {"month_year"}, {{"data", each _, type table [report_date=nullable date, year=number, quarter=text, month=number, month_name=text, end_of_month=date]}}),
				    #"Added month_year_sort" = Table.AddIndexColumn(#"Grouped Rows by month_year", "month_year_sort", 0, 1, Int64.Type),
				    #"Expanded data" = Table.ExpandTableColumn(#"Added month_year_sort", "data", {"report_date", "year", "quarter", "month", "month_name", "start_of_month"}, {"report_date", "year", "quarter", "month", "month_name", "start_of_month"}),
				
				    #"Changed Type" = Table.TransformColumnTypes(#"Expanded data",{{"report_date", type date}, {"start_of_month", type date}, {"month_year_sort", Int64.Type}, {"month", Int64.Type}, {"year", Int64.Type}}),
				    #"Sorted Rows" = Table.Sort(#"Changed Type",{{"report_date", Order.Descending}})
				in
				    #"Sorted Rows"
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

