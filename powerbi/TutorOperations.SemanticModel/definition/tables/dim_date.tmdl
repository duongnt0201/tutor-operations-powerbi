	column week_of_month =
			
			VAR x = DATE(YEAR('dim_date'[report_date]), MONTH('dim_date'[report_date]), 1)
			VAR WeekNum = WEEKNUM('dim_date'[report_date], 2) - WEEKNUM(x, 2) + 1
			RETURN WeekNum
		formatString: 0
		lineageTag: ddaec64a-56f7-4ace-8001-3da7113497ae
		summarizeBy: none

		annotation SummarizationSetBy = User

	column day_of_week = ```
			
			SWITCH(
			    WEEKDAY('dim_date'[report_date], 2),
