			        fact_schedule_class,
			        NOT CONTAINSSTRING ( fact_schedule_class[start_time], "18:00" ) &&
			        NOT CONTAINSSTRING ( fact_schedule_class[start_time], "19:00" ) &&
			        NOT CONTAINSSTRING ( fact_schedule_class[start_time], "20:00" ) &&
			        NOT CONTAINSSTRING ( fact_schedule_class[start_time], "21:00" )
			    )
			    ,not fact_schedule_class[schedule_status] in {"WAITING_CANCELLATION_CONFIRMATION", "CANCELED"}
			    ,dim_teacher_status[work_status] <> "Sắp nghỉ"
