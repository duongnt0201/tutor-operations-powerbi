	measure 'V_ACS vs Last Month' =
			
			VAR lastMonth =
			    CALCULATE(
			        [ACS],
			        DATEADD('dim_date'[report_date], -1, MONTH)
			    )
			VAR _dif =
			    DIVIDE([ACS] - lastMonth, lastMonth)
			VAR _format =
			    FORMAT(ABS(_dif), "0.00%")
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(lastMonth), BLANK(),
			    _dif >= 0, "▲ " & _format & " vs Last Month",
			    _dif < 0, "▼ " & _format & " vs Last Month",
			    BLANK()
			)
		displayFolder: 2. ACS
		lineageTag: 9c74a1ff-ca9a-4864-9aa0-8b970384b659

