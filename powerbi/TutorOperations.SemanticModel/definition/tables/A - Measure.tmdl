	measure 'số GS regular đạt điều kiện' = ```
			
			CALCULATE(
			    [số GS regular active],
			    FILTER(
			        VALUES(fact_schedule_class[teacher_id]),
			        CALCULATE(COUNT(fact_schedule_class[id]), fact_schedule_class[IS_SCHEDULE_REQUIRED] = 1) >= 2 -- tối thiếu 2 ca bắt buộc
			    ),
			    FILTER(
			        VALUES(fact_schedule_class[teacher_id]),
			        CALCULATE(COUNT(fact_schedule_class[id]), fact_schedule_class[evening_shift] = 1) >= 10 -- tối thiếu 10 ca buổi tối 1 tuần
			    ),
			    FILTER(
			        VALUES(fact_schedule_class[teacher_id]),
			        CALCULATE(COUNT(fact_schedule_class[id])) >= 12 -- tối thiếu 12 ca 1 tuần
			    )
			)
			
			```
		formatString: #,0
		displayFolder: 6. Đặt lịch GS\6.1. Chiều lớp
		lineageTag: 5b88f09b-29af-4ddd-a19b-5262dc8b7a7a

