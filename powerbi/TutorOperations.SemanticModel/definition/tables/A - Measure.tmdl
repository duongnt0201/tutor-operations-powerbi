	measure 'số lớp bị backup' =
			CALCULATE(
			    [số lớp]
			    , fact_regular_session[is_backup] = 1
			)
		formatString: #,0
		displayFolder: 5. Lớp BU
		lineageTag: 3bf63e72-9292-4afa-a419-824a7f0f19a2

	measure 'số lớp bị backup x+ lần' =
			
			VAR _slt = SELECTEDVALUE(para_backup[para_backup], 2)
			RETURN
			COUNTROWS(
			    FILTER(
			        SUMMARIZECOLUMNS(
			            fact_regular_session[learn_month],
			            fact_regular_session[class_code],
			
			            "total_session",
			                CALCULATE(
			                    DISTINCTCOUNT(fact_regular_session[class_session_code]),
			                    fact_regular_session[session_status] = "DONE",
			                    fact_regular_session[student_status] IN {
			                        "SUCCESS",
			                        "FAILED_STUDENT_NO_LEARNED"
			                    }
			                ),
			
			            "total_backup_session",
			                CALCULATE(
			                    DISTINCTCOUNT(fact_regular_session[class_session_code]),
			                    fact_regular_session[is_backup] = 1,
			                    fact_regular_session[session_status] = "DONE",
			                    fact_regular_session[student_status] IN {
			                        "SUCCESS",
			                        "FAILED_STUDENT_NO_LEARNED"
			                    }
			                )
			        ),
			        [total_backup_session] >= _slt
			            && NOT ISBLANK(fact_regular_session[class_code])
			    )
			)
		formatString: #,0
		displayFolder: 5. Lớp BU
		lineageTag: 45eeb06a-5dc6-46ae-a586-5a5b51905181

	measure '% lớp bị backup' = DIVIDE([số lớp bị backup], [số lớp], BLANK())
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 5. Lớp BU
		lineageTag: c88ab468-ab07-4185-babd-fe5bbc65ee05

