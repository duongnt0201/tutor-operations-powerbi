	measure 'số HS nghỉ > 1 buổi trong tháng' = ```
			
			VAR _student_cancel =
			    SUMMARIZE(
			        FILTER(
			            fact_regular_session,
			            fact_regular_session[student_status] <> "SUCCESS" 
			            && CONTAINSSTRING(fact_regular_session[session_status], "DONE")
			        ),
			        fact_regular_session[student_id],
			        "cancel_cnt", COUNTROWS(fact_regular_session)
			    )
			RETURN
			COUNTROWS(
			    FILTER(
			        _student_cancel,
			        [cancel_cnt] > 1
			    )
			)
			```
		formatString: #,0
		displayFolder: 4. Lượt học\4.2. Vào lớp
		lineageTag: 57773198-9e75-46b5-ae44-0edb99d7e94b

	measure 'số lịch đăng ký' = ```
			
			CALCULATE (
			    DISTINCTCOUNT ( fact_schedule_class[id] ),
			    FILTER (
			        fact_schedule_class,
			        NOT CONTAINSSTRING ( fact_schedule_class[start_time], "18:00" ) &&
			        NOT CONTAINSSTRING ( fact_schedule_class[start_time], "19:00" ) &&
			        NOT CONTAINSSTRING ( fact_schedule_class[start_time], "20:00" ) &&
			        NOT CONTAINSSTRING ( fact_schedule_class[start_time], "21:00" )
			    )
			    ,not fact_schedule_class[schedule_status] in {"WAITING_CANCELLATION_CONFIRMATION", "CANCELED"}
			    , dim_teacher_status[work_status] <> "Sắp nghỉ"
			)
			
			```
		formatString: #,0
		displayFolder: 6. Đặt lịch GS\6.1. Chiều lớp
		lineageTag: b257683b-5a74-4105-8f9e-dec14db99b7d

