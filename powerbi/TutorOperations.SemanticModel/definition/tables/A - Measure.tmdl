	measure 'V_% lịch GS nhận vs Last Month' =
			
			VAR lastMonth =
			    CALCULATE(
			        [% lịch GS nhận],
			        DATEADD('dim_date'[report_date], -1, MONTH)
			    )
			VAR _dif =
			    DIVIDE([% lịch GS nhận] - lastMonth, lastMonth)
			VAR _format =
			    FORMAT(ABS(_dif), "0.00%")
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(lastMonth), BLANK(),
			    _dif >= 0, "▲ " & _format & " vs Last Month",
			    _dif < 0, "▼ " & _format & " vs Last Month",
			    BLANK()
			)
		displayFolder: 6. Đặt lịch GS\6.2. Chiều GS
		lineageTag: e18d8dfc-40b7-4b23-9c93-ec9535334ecd

	partition 'A - Measure' = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

