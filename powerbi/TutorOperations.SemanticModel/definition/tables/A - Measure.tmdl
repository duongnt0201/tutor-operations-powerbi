	measure Measure
		displayFolder: 1. Xếp lớp
		lineageTag: 60619497-3574-47ec-9c42-d6d1e436b73b

		annotation 436ba87b-9c83-4389-a31b-ebd06a36be98 = {"Expression":null}

		annotation 277cc1b9-af89-4597-8e15-cacc25c0886b = To use special characters in a measure name, enclose the entire name in brackets ( [] ) and add a ] to any closing brackets in the name.

	measure 'số lớp bị backup 2+ lần' =
			
			VAR _slt = SELECTEDVALUE(para_backup[para_backup], 2)
			RETURN
			COUNTROWS(
			    FILTER(
			        SUMMARIZECOLUMNS(
			            fact_regular_session[learn_month],
			            fact_regular_session[class_code],
			
			            "total_session",
			                CALCULATE(
			                    DISTINCTCOUNT(fact_regular_session[class_session_code]),
			                    fact_regular_session[session_status] = "DONE",
			                    fact_regular_session[student_status] IN {
			                        "SUCCESS",
			                        "FAILED_STUDENT_NO_LEARNED"
			                    }
			                ),
			
			            "total_backup_session",
			                CALCULATE(
			                    DISTINCTCOUNT(fact_regular_session[class_session_code]),
			                    fact_regular_session[is_backup] = 1,
			                    fact_regular_session[session_status] = "DONE",
			                    fact_regular_session[student_status] IN {
			                        "SUCCESS",
			                        "FAILED_STUDENT_NO_LEARNED"
			                    }
			                )
			        ),
			        [total_backup_session] >= 2
			            && NOT ISBLANK(fact_regular_session[class_code])
			    )
			)
		formatString: #,0
		displayFolder: 5. Lớp BU
		lineageTag: 996c8550-41b7-4916-9e2d-e096f0ac25cb

	measure 'số đơn PTC D ngày' = ```
			
			-- Tỷ lệ liên hệ thành công trong D+x (x: nhập số vào báo cáo tự nhảy số theo)
			var _slt = SELECTEDVALUE(para_day[para_day], 5) 
			RETURN
			CALCULATE(
			    [số đơn PTC]
			    // , fact_arrange_class[ARRANGE_STATUS] = "DONE"
			    // , fact_arrange_class[arrange_type] = "NEW"
			    , DATEDIFF(fact_arrange_class[ptc_date], fact_arrange_class[arrange_success_date], DAY) <=  _slt
			)
			```
		formatString: #,0
		displayFolder: 1. Xếp lớp
		lineageTag: 2f4186da-9841-4342-96cb-433221f2b33f

