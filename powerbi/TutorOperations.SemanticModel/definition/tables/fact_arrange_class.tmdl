	column day_to_assigned_arrange = DATEDIFF(fact_arrange_class[ptc_date], fact_arrange_class[first_learn_date],day)
		formatString: 0
		lineageTag: 8b3dc5e4-0092-425f-a9d2-e5cbe91c3736
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column day_to_first_learn = ```
			
			var x = DATEDIFF(fact_arrange_class[ptc_date], fact_arrange_class[first_learn_date], day)
			RETURN
			SWITCH( 
			    TRUE()
			    , x <= 3, "D0 - D3"
			    , x > 3 && x <= 7, "D4 - D7"
			    , x > 7 && x <= 10, "D8 - D10"
			    , x > 10 && x <= 14, "D11 - D14"
			    , ">D14"
			)
			```
		lineageTag: 526c6bf1-60d8-44c6-8c12-3f0f537c4e5e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

