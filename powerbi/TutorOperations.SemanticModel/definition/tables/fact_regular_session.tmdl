	column session_number_type =
			
			VAR cur_teacher = 'fact_regular_session'[teacher_id]
			VAR cur_class = 'fact_regular_session'[class_code]
			VAR cur_week = RELATED('dim_date'[week_of_year])
			VAR cur_date = 'fact_regular_session'[learn_date]
			VAR cur_start_time = 'fact_regular_session'[start_time]
			VAR x =
			    RANKX(
			        FILTER(
			            'fact_regular_session',
			            'fact_regular_session'[teacher_id] = cur_teacher
			                && 'fact_regular_session'[class_code] = cur_class
			                && RELATED('dim_date'[week_of_year]) = cur_week
			        ),
			        'fact_regular_session'[learn_date] & 'fact_regular_session'[start_time],
			        cur_date & cur_start_time,
			        ASC,
			        DENSE
			    )
			RETURN
			"Buổi " & x
		lineageTag: 5545344e-0a77-4541-9249-801304260f3d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

